# ===========================================
# Biblioteca Betim API - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# ===========================================

# -------------------------------------------
# Banco de Dados (PostgreSQL)
# -------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bibliotecabetim
DB_USER=postgres
DB_PASSWORD=postgres

# -------------------------------------------
# Aplicação
# -------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# -------------------------------------------
# JWT (Autenticação)
# -------------------------------------------
# Mínimo de 32 caracteres para produção
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRATION_MS=86400000

# -------------------------------------------
# E-mail (MailHog em desenvolvimento)
# -------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# -------------------------------------------
# CORS (origem do frontend)
# -------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# -------------------------------------------
# Regras de Negócio
# -------------------------------------------
LOAN_DAYS=14
MAX_RENEWALS=2
MAX_LOANS_PER_USER=3
RESERVATION_HOLD_HOURS=48